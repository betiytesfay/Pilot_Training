# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram Username (with @) to display to users
ADMIN_USERNAME=@your_admin_username

# Admin Telegram Chat ID (numeric ID where unmatched questions will be forwarded)
# You can get your Chat ID by talking to @userinfobot or @raw_data_bot on Telegram
ADMIN_CHAT_ID=123456789
